 	}
-	for _, out := range outputs {
-		r.barrier.Open(out)
-	}
 	return func() {
 		for _, out := range outputs {
 			r.barrier.Settle(out)
@@ -116,6 +113,7 @@ func (r *Run) claimAll(id record.TaskID, outputs []string) error {
 		if err := r.claimOutputLocked(id, producerExec, out); err != nil {
 			return err
 		}
